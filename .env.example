# Optional. Copy to .env and adjust. It has two independent uses:
#
#   1. docker compose (the default way to develop; see the README). Compose reads this file
#      only to fill in ${...} in docker-compose.yml, which means the host ports below. The
#      compose stack's app settings live in compose/environment/, and Django inside the
#      containers ignores this file (JHE_IGNORE_DOTENV).
#
#   2. Running Django directly on your machine ("Getting Started (without Docker)" in the
#      README). Django's load_dotenv() reads the settings in section 2.
#
# Most configuration lives in the database as JheSettings (System Settings in the web UI).
# Env vars are only for values needed before those can be read.

# --- 1. docker compose host ports (defaults: 8000, 5432, 8401) ----------------------------
# JHE_PORT=8000
# JHE_DB_PORT=5432
# MCP_PORT=8401

# --- 2. Running Django on the host ---------------------------------------------------------

# Any non-empty value turns debug mode on, including "False". In production, leave it
# unset. Locally it's needed for runserver to serve static files.
DEBUG=1
SITE_URL="http://localhost:8000"

DB_NAME="jhe_dev"
DB_USER="jheuser"
DB_PASSWORD="jhepassword"
DB_HOST="localhost"
DB_PORT=5432

# Generate with `openssl genrsa -out oidc.key 4096`, then paste it as one line with \n
# between lines (see the README).
OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII... ...\n-----END PRIVATE KEY-----"

# If unset, a random value is generated at startup, which breaks with more than one worker.
SECRET_KEY=

# Optional:
# ALLOWED_HOSTS=localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# DJANGO_LOG_LEVEL=INFO
# TIME_ZONE=UTC