{
  "identity": {
    "class": "patient_access.identity.jwt_deeplink.JwtDeepLinkIdentity",
    "options": {
      "issuers": {
        "study-dev": "/code/compose/dev-keys/deeplink-study-dev.pub.pem"
      },
      "deeplink_store": {
        "class": "patient_access.django_apps.deeplink.stores.OrmDeepLinkStore"
      },
      "mint": {
        "iss": "study-dev",
        "private_key": "/code/compose/dev-keys/deeplink-study-dev.pem"
      }
    }
  },
  "directory": {
    "class": "patient_access.django_apps.directory.stores.OrmDirectory"
  },
  "spool": {
    "class": "patient_access.spool.local_disk.LocalDiskSpool",
    "options": {
      "root": "${PA_SPOOL_DIR}"
    }
  },
  "destinations": {
    "local": {
      "formatter": {
        "class": "patient_access.formatters.composition.CompositionBundleFormatter"
      },
      "sink": {
        "class": "patient_access.destinations.local_dir.LocalDirectorySink",
        "options": {
          "root": "${PA_OUT_DIR}"
        }
      }
    },
    "s3": {
      "formatter": {
        "class": "patient_access.formatters.composition.CompositionBundleFormatter"
      },
      "sink": {
        "class": "patient_access.destinations.s3.S3Sink",
        "options": {
          "bucket": "patient-access",
          "layout": "pulls/{participant.ref}/{job.id}",
          "endpoint_url": "${PA_S3_ENDPOINT}",
          "access_key": "${PA_S3_ACCESS_KEY}",
          "secret_key": "${PA_S3_SECRET_KEY}",
          "create_bucket": true
        }
      }
    }
  },
  "default_destination": "${PA_DESTINATION}",
  "dispatcher": {
    "class": "patient_access.dispatch.db_polling.DbPollingDispatcher",
    "options": {
      "interval_seconds": 2,
      "lease_seconds": 600,
      "sweep_every": 10,
      "spool_max_age_hours": 24
    }
  },
  "max_attempts": 3,
  "vendors": {
    "smart-public": {
      "client_id": "patient-access-sketch",
      "auth_method": "public",
      "base_scopes": [
        "launch/patient",
        "openid",
        "fhirUser"
      ],
      "profile": "smart-reference"
    },
    "smart-symmetric": {
      "client_id": "patient-access-sketch",
      "auth_method": "client_secret_basic",
      "client_secret_env": "PA_SMART_SANDBOX_CLIENT_SECRET",
      "base_scopes": [
        "launch/patient",
        "openid",
        "fhirUser"
      ],
      "profile": "smart-reference"
    },
    "smart-asymmetric": {
      "client_id": "patient-access-sketch",
      "auth_method": "private_key_jwt",
      "private_key_path": "/code/compose/dev-keys/smart-client-dev.pem",
      "key_id": "sketch-1",
      "jwt_alg": "RS384",
      "base_scopes": [
        "launch/patient",
        "openid",
        "fhirUser"
      ],
      "profile": "smart-reference"
    }
  },
  "seed": {
    "bundles": [
      {
        "file": "/code/compose/data/epic-brands.sample.json",
        "vendor": "epic"
      }
    ],
    "smart_sandbox": [
      {
        "id": "smart-public",
        "name": "SMART Sandbox Health (public client)",
        "vendor": "smart-public",
        "line": "1 Sandbox Way",
        "city": "Boston",
        "state": "MA",
        "postal": "02115",
        "launch": {
          "client_type": "public",
          "pkce": "always"
        }
      },
      {
        "id": "smart-symmetric",
        "name": "SMART Sandbox Health (confidential symmetric)",
        "vendor": "smart-symmetric",
        "line": "2 Sandbox Way",
        "city": "Boston",
        "state": "MA",
        "postal": "02115",
        "launch": {
          "client_type": "confidential-symmetric",
          "pkce": "auto",
          "client_secret": "${PA_SMART_SANDBOX_CLIENT_SECRET}"
        }
      },
      {
        "id": "smart-asymmetric",
        "name": "SMART Sandbox Health (confidential asymmetric)",
        "vendor": "smart-asymmetric",
        "line": "3 Sandbox Way",
        "city": "Boston",
        "state": "MA",
        "postal": "02115",
        "launch": {
          "client_type": "confidential-asymmetric",
          "pkce": "auto",
          "jwks_public_key": "/code/compose/dev-keys/smart-client-dev.pub.pem",
          "kid": "sketch-1",
          "alg": "RS384"
        }
      },
      {
        "id": "smart-express",
        "name": "SMART Sandbox Express (scripted: no login, fixed patient)",
        "vendor": "smart-public",
        "line": "4 Sandbox Way",
        "city": "Cambridge",
        "state": "MA",
        "postal": "02139",
        "launch": {
          "client_type": "public",
          "pkce": "always",
          "skip_login": true,
          "skip_auth": true,
          "patient": [
            "12edb5a0-ec71-45b7-aff6-0fef1c382881"
          ]
        }
      },
      {
        "id": "smart-express-symmetric",
        "name": "SMART Sandbox Express symmetric (scripted)",
        "vendor": "smart-symmetric",
        "line": "5 Sandbox Way",
        "city": "Cambridge",
        "state": "MA",
        "postal": "02139",
        "launch": {
          "client_type": "confidential-symmetric",
          "pkce": "auto",
          "client_secret": "${PA_SMART_SANDBOX_CLIENT_SECRET}",
          "skip_login": true,
          "skip_auth": true,
          "patient": [
            "80a75b5a-fd30-4f38-895d-d8098fe7206e"
          ]
        }
      },
      {
        "id": "smart-express-asymmetric",
        "name": "SMART Sandbox Express asymmetric (scripted)",
        "vendor": "smart-asymmetric",
        "line": "6 Sandbox Way",
        "city": "Cambridge",
        "state": "MA",
        "postal": "02139",
        "launch": {
          "client_type": "confidential-asymmetric",
          "pkce": "auto",
          "jwks_public_key": "/code/compose/dev-keys/smart-client-dev.pub.pem",
          "kid": "sketch-1",
          "alg": "RS384",
          "skip_login": true,
          "skip_auth": true,
          "patient": [
            "80a75b5a-fd30-4f38-895d-d8098fe7206e"
          ]
        }
      }
    ]
  }
}
