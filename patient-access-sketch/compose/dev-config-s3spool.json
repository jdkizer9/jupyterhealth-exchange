{
  "extends": "/code/compose/dev-config.json",
  "spool": {
    "class": "patient_access.spool.s3_staging.S3StagingSpool",
    "options": {
      "bucket": "patient-access", "prefix": "staging", "endpoint_url": "${PA_S3_ENDPOINT}",
      "access_key": "${PA_S3_ACCESS_KEY}", "secret_key": "${PA_S3_SECRET_KEY}",
      "chunk": 500, "expire_days": 1, "create_bucket": true
    }
  }
}
