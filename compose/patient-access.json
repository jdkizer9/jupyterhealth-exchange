{
  "_about": "Patient Access Module config for JHE (sketch, scenario D). Dev-only values; see core/patient_access/.",
  "identity": {
    "class": "core.patient_access.identity.JheUserIdentity"
  },
  "directory": {
    "class": "core.patient_access.directory.JheOrmDirectory"
  },
  "spool": {
    "class": "patient_access.spool.local_disk.LocalDiskSpool",
    "options": {
      "root": "/code/local/patient-access/spool"
    }
  },
  "destinations": {
    "jhe": {
      "formatter": {
        "class": "patient_access.formatters.r4_batch.R4BatchFormatter",
        "options": {
          "chunk": 100
        }
      },
      "sink": {
        "class": "core.patient_access.sink.JheDirectSink"
      },
      "content": {
        "documents": false
      }
    },
    "s3": {
      "formatter": {
        "class": "patient_access.formatters.composition.CompositionBundleFormatter"
      },
      "sink": {
        "class": "patient_access.destinations.s3.S3Sink",
        "options": {
          "bucket": "patient-access",
          "layout": "{attrs[patient_id]}/{attrs[fhir_source_id]}",
          "endpoint_url": "http://silo:9000",
          "access_key": "patient-access-dev",
          "secret_key": "patient-access-dev-secret",
          "create_bucket": true
        }
      },
      "required": true
    }
  },
  "dispatcher": {
    "class": "patient_access.dispatch.thread.ThreadDispatcher",
    "options": {
      "lease_seconds": 600
    }
  },
  "redirect_uri": "${SITE_URL}/clients/uscdi-patient-access/callback",
  "max_attempts": 3,
  "vendors": {
    "Epic Sandbox": {
      "client_id": "77849e74-8e2a-4c2f-826c-bdbef6da3357",
      "base_scopes": [
        "openid",
        "profile",
        "launch/patient"
      ],
      "profile": "epic",
      "auth_methods": [
        {
          "method": "public"
        }
      ]
    },
    "SMART Sandbox": {
      "client_id": "patient-access-sketch",
      "base_scopes": [
        "launch/patient",
        "openid",
        "fhirUser"
      ],
      "profile": "smart-reference",
      "auth_methods": [
        {
          "method": "public"
        }
      ]
    },
    "SMART Sandbox Asymmetric": {
      "client_id": "patient-access-sketch",
      "base_scopes": [
        "launch/patient",
        "openid",
        "fhirUser"
      ],
      "profile": "smart-reference",
      "auth_methods": [
        {
          "method": "private_key_jwt",
          "kid": "sketch-1",
          "alg": "RS384"
        }
      ]
    }
  },
  "seed": {
    "smart_sandbox": [
      {
        "name": "SMART Sandbox Health",
        "vendor": "SMART Sandbox",
        "line": "1 Sandbox Way",
        "city": "Boston",
        "state": "MA",
        "postal": "02115",
        "launch": {
          "client_type": "public",
          "pkce": "always"
        }
      },
      {
        "name": "SMART Sandbox Express (no login, fixed patient)",
        "vendor": "SMART Sandbox",
        "line": "4 Sandbox Way",
        "city": "Cambridge",
        "state": "MA",
        "postal": "02139",
        "launch": {
          "client_type": "public",
          "pkce": "always",
          "skip_login": true,
          "skip_auth": true,
          "patient": [
            "12edb5a0-ec71-45b7-aff6-0fef1c382881"
          ]
        }
      },
      {
        "name": "SMART Sandbox Express Asymmetric (no login, fixed patient)",
        "vendor": "SMART Sandbox Asymmetric",
        "line": "6 Sandbox Way",
        "city": "Cambridge",
        "state": "MA",
        "postal": "02139",
        "launch": {
          "client_type": "confidential-asymmetric",
          "pkce": "auto",
          "jwks_public_key": "/code/patient-access-sketch/compose/dev-keys/smart-client-dev.pub.pem",
          "kid": "sketch-1",
          "alg": "RS384",
          "skip_login": true,
          "skip_auth": true,
          "patient": [
            "80a75b5a-fd30-4f38-895d-d8098fe7206e"
          ]
        }
      }
    ]
  },
  "signing_keys": {
    "class": "patient_access.credentials.env.EnvSigningKeys",
    "options": {
      "keys": [
        {
          "kid": "sketch-1",
          "alg": "RS384",
          "path": "/code/patient-access-sketch/compose/dev-keys/smart-client-dev.pem"
        }
      ]
    }
  },
  "default_destinations": [
    "jhe",
    "s3"
  ]
}
