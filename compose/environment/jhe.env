# JHE Django settings for the local docker compose stack.
#
# Committed on purpose: every value here is public and local-only. It unlocks nothing
# outside your own machine. Never copy these into a real deployment, and never add them
# as fallbacks in jhe/settings.py.
#
# Load order (docker-compose.yml `env_file`), later wins:
#   1. ci/test_env.sh                 base values shared with CI, incl. the public test OIDC key
#   2. compose/environment/jhe.env            (this file) overrides for the compose stack
#   3. compose/environment/local.secret.env   optional, gitignored: your real third-party credentials
# `environment:` in docker-compose.yml beats all three; it sets SITE_URL and
# MCP_OAUTH_REDIRECT_URI because they depend on the published host ports.

DEBUG=1
DJANGO_LOG_LEVEL=INFO

# Container-to-container calls (the MCP server hitting http://jhe:8000) need "jhe".
ALLOWED_HOSTS=localhost,127.0.0.1,jhe

# Point at the compose `db` service. A different DB name from CI's test_jhe_dev makes it
# obvious which stack you're connected to.
DB_NAME=jhe_dev
DB_HOST=db
DB_PORT=5432

# OAuth app that `manage.py seed` creates for the MCP server. Must match
# JHE_CLIENT_ID / JHE_CLIENT_SECRET in compose/environment/mcp.env.
MCP_OAUTH_CLIENT_ID=jhe-mcp-local
MCP_OAUTH_CLIENT_SECRET=dev-insecure-mcp-client-secret
