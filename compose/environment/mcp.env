# MCP server settings for the local docker compose stack (public, local-only).
#
# JHE_BASE_URL, JHE_AUTHORIZE_ENDPOINT, MCP_RESOURCE_URL and MCP_HTTP_PORT depend on the
# published ports, so docker-compose.yml sets them.

# Must match MCP_OAUTH_CLIENT_ID / MCP_OAUTH_CLIENT_SECRET in compose/environment/jhe.env: that
# is the OAuth app `manage.py seed` creates for this server in JHE.
JHE_CLIENT_ID=jhe-mcp-local
JHE_CLIENT_SECRET=dev-insecure-mcp-client-secret

# Encrypts the broker's stateless OAuth blobs. Any string of 32+ characters.
MCP_BROKER_KEY=dev-insecure-mcp-broker-key-0123456789abcdef
